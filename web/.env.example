# chatislam/web — Astro 5 environment variables
# Copy to .env.local and fill in values.
# Migration: Next.js NEXT_PUBLIC_* → PUBLIC_* (Astro convention)
# REF: P2-E3-W02-S02-T02

# ─── Public (exposed to client islands) ─────────────────────────────────────

# Hasura GraphQL endpoint (per-app CORS-restricted)
PUBLIC_HASURA_URL=https://api.chatislam.local.nself.org:8543/v1/graphql

# Hasura Auth endpoint (shared SSO across all apps)
PUBLIC_AUTH_URL=https://auth.local.nself.org:8543

# Public base URL for this app
PUBLIC_BASE_URL=https://www.chatislam.local.nself.org:8543

# Cloudflare Turnstile site key (D-P3-20 — client widget). Get from CF dashboard.
PUBLIC_TURNSTILE_SITE_KEY=

# Chat proxy URL — Cloudflare Worker (infra repo) for rate-limit + Turnstile + AI
# Local dev: use /api/chat (Astro endpoint) until CF Worker is deployed
PUBLIC_CHAT_PROXY_URL=/api/chat

# Umami analytics (D-P3-21)
PUBLIC_UMAMI_WEBSITE_ID=

# ─── Server-only (never expose to browser) ───────────────────────────────────

# Cloudflare Turnstile secret key (server-side verify)
TURNSTILE_SECRET_KEY=

# Auth redirect URL for this app
AUTH_CLIENT_URL=https://chatislam.org

# AI provider: anthropic_direct | nself_ai (swap post Track-A6)
AI_PROVIDER=anthropic_direct

# Anthropic Claude (D-P3-44: direct in P3; migrates to nself-ai post A6)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Rate limiting — Redis (via nSelf: redis://localhost:6379)
REDIS_URL=redis://localhost:6379

# Monitoring — Sentry (D-P2-SENTRY-SOT: Sentry only, no GlitchTip)
# Use vault key SENTRY_DSN_CHATISLAM
SENTRY_DSN_CHATISLAM=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=ummeco
SENTRY_PROJECT=chatislam-web

# Daily token budget (SCI-04)
CHAT_DAILY_TOKEN_CAP=50000

# BYO API key encryption (SCI-18) — AES-256-GCM, 32-byte hex
BYO_KEY_ENCRYPTION_SECRET=

# Spend alert cron (SCI-05)
SPEND_ALERT_THRESHOLD_USD=5.00
ALERT_EMAIL=aric.camarata@gmail.com
CRON_SECRET=

# Hasura admin (server-side only)
HASURA_ADMIN_URL=https://api.ummat.dev/v1/graphql
HASURA_ADMIN_SECRET=

# Remote Schema secret
REMOTE_SCHEMA_SECRET=

# Widget embed allowed origins
WIDGET_ALLOWED_ORIGINS=https://ummat.app

# Feature flags
FF_MADHHAB=true
FF_DAWAH_MODE=true
FF_SEASONAL_MODE=true
FF_CONVERSATION_HISTORY=true
FF_FEYNMAN_AGENT=true

# Feynman Research Agent
FEYNMAN_CACHE_TTL_HOURS=24
ISLAMWIKI_BASE_URL=https://islam.wiki
ISLAMWIKI_CITATION_API=https://islam.wiki/api/citation
CITATION_CACHE_TTL_SECONDS=3600

# AI Tutor
TUTOR_MASTERY_ADVANCE_THRESHOLD=80
TUTOR_MASTERY_REGRESS_THRESHOLD=30

# Stream interruption recovery
STREAM_PARTIAL_TTL_SECONDS=300

# OpenTelemetry / Tempo (server-side only)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=chatislam-web
