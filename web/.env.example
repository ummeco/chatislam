# chatislam/web — environment variables
# Copy to .env.local and fill in values
# Run: next dev --port 3042

# Hasura GraphQL endpoint (per-app CORS-restricted)
NEXT_PUBLIC_HASURA_URL=https://api.chatislam.local.nself.org:8543/v1/graphql

# Hasura Auth endpoint (shared SSO across all apps)
NEXT_PUBLIC_AUTH_URL=https://auth.local.nself.org:8543

# Auth client URL scoped to THIS app — tells Hasura Auth where to redirect after email confirm.
# Prod: sourced from vault AUTH_CLIENT_URL_CHATISLAM.
AUTH_CLIENT_URL=https://chatislam.org

# Public base URL for this app
NEXT_PUBLIC_BASE_URL=https://www.chatislam.local.nself.org:8543

# Secret for validating Remote Schema requests from Hasura
REMOTE_SCHEMA_SECRET=

# AI provider (D-P3-44 / Track A6)
# Values: anthropic_direct (P3 default) | nself_ai (post Track-A6 migration)
# Swap to nself_ai when nSelf ships nself-ai plugin. Spec: .github/docs/nself-ai-sdk-interface.md
AI_PROVIDER=anthropic_direct

# Anthropic Claude — direct API (active in P3; removed post-A6 if nself-ai fully replaces)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Track A6 — nself-ai plugin vars (placeholders; NOT active in P3)
# Uncomment and fill after nSelf releases nself-ai plugin and A6-02 runs.
# NSELF_AI_API_KEY=
# NSELF_AI_BASE_URL=
# NSELF_AI_MODEL_POOL=local,anthropic
# NSELF_AI_RATE_LIMIT_REQUESTS_PER_MIN=20
# NSELF_AI_RATE_LIMIT_TOKENS_PER_DAY=50000
# NSELF_AI_RATE_LIMIT_BYO_KEY_BYPASS=true
# NSELF_AI_FALLBACK_TO_DIRECT=false

# Rate limiting — Redis (T0-04-01)
# Local: nSelf Redis at redis://localhost:6379 (via nself start)
REDIS_URL=redis://localhost:6379

# Monitoring — Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=ummeco
SENTRY_PROJECT=chatislam-web

# Monitoring — Umami analytics (D-P3-21)
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Daily token budget (SCI-04)
# Cap per authenticated user per day. Default: 50000 tokens (~$0.15 at Sonnet pricing).
CHAT_DAILY_TOKEN_CAP=50000

# BYO API key encryption (SCI-18) — AES-256-GCM, must be 32-byte hex (openssl rand -hex 32)
BYO_KEY_ENCRYPTION_SECRET=

# Spend alert cron (SCI-05)
# Daily spend threshold in USD — cron alerts if estimated spend exceeds this.
SPEND_ALERT_THRESHOLD_USD=5.00
# Email address to send spend alerts to (admin)
ALERT_EMAIL=aric.camarata@gmail.com
# Vercel cron security secret — must match CRON_SECRET set in Vercel project env.
# Vercel automatically sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Hasura admin endpoint for server-side cron queries (never expose to browser)
HASURA_ENDPOINT=https://api.ummat.dev/v1/graphql
HASURA_ADMIN_SECRET=

# Widget embed (SCI-16)
# Comma-separated list of allowed parent origins (no trailing slash)
WIDGET_ALLOWED_ORIGINS=https://ummat.app

# ─── P4 — S20 ChatIslam Public Beta ──────────────────────────────────────────

# Feynman Research Agent (CB-01)
# Feature flag — set to 'false' to disable the /research endpoint
FF_FEYNMAN_AGENT=true
# Cache TTL for Feynman research results in hours
FEYNMAN_CACHE_TTL_HOURS=24
# Islam.wiki base URL for citation verification
ISLAMWIKI_BASE_URL=https://islam.wiki
# Islam.wiki citation verification API (CB-06)
ISLAMWIKI_CITATION_API=https://islam.wiki/api/citation
# Citation URL cache TTL in seconds
CITATION_CACHE_TTL_SECONDS=3600

# Multi-Madhhab Clarity (CB-02)
# Feature flag — set to 'false' to disable madhhab tagging
FF_MADHHAB=true

# AI Tutor (CB-03)
# Feature flag — set to 'false' to disable the /tutor endpoint and pages
FF_AI_TUTOR=true
# Mastery advance threshold (0-100) — advance level when average mastery >= this
TUTOR_MASTERY_ADVANCE_THRESHOLD=80
# Mastery regress threshold (0-100) — regress level when average mastery < this
TUTOR_MASTERY_REGRESS_THRESHOLD=30

# Dawah Mode (CB-04)
# Feature flag — set to 'false' to disable /dawah page
FF_DAWAH_MODE=true

# Seasonal Mode (CB-05)
# Feature flag — set to 'false' to disable seasonal theming
FF_SEASONAL_MODE=true
# Override active mode regardless of calendar (for testing)
# Values: ramadan | eid_al_fitr | eid_al_adha | dhul_hijjah | (empty = auto)
SEASONAL_MODE_OVERRIDE=
# Optional moon sighting API for Ramadan start adjustment
SEASONAL_MOON_SIGHTING_API=

# Conversation History (CB-07)
# Feature flag — set to 'false' to disable session persistence
FF_CONVERSATION_HISTORY=true
# Client-side feature flag (must be prefixed NEXT_PUBLIC_)
NEXT_PUBLIC_FF_CONVERSATION_HISTORY=true

# Stream Interruption Recovery (CB-08)
# TTL for partial stream content stored in Redis (seconds)
STREAM_PARTIAL_TTL_SECONDS=300

# Hasura admin endpoint (server-side only — never expose to browser)
# Used by all P4 server-side API routes
HASURA_ADMIN_URL=https://api.ummat.dev/v1/graphql
HASURA_GRAPHQL_ADMIN_SECRET=

# ─── OpenTelemetry / Tempo traces (T25.09) ────────────────────────────────────
# OTLP HTTP endpoint for Tempo (server-side traces — never NEXT_PUBLIC_*)
# Prod: https://tempo.ummat.dev/v1/traces (nginx proxy to port 4318 on ummat-prod)
# Local: leave unset — OTel init is gated on this var being present
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=chatislam-web
