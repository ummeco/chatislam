{
  "name": "chatislam-web",
  "version": "0.1.3",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3042",
    "build": "next build",
    "start": "next start --port 3042",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "pnpx tsx ~/Sites/ummeco/scripts/setup.sh",
    "doctor": "pnpx tsx ~/Sites/ummeco/scripts/doctor.ts",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "env:refresh": "bash ~/Sites/ummeco/scripts/env-refresh.sh",
    "console:hasura": "open http://localhost:5543",
    "console:mail": "open http://localhost:5043",
    "console:storage": "open http://localhost:5443",
    "console:search": "open http://localhost:7700"
  },
  "dependencies": {
    "@ummat/consent": "file:./vendor/consent",
    "@anthropic-ai/sdk": "^0.91.1",
    "@opentelemetry/auto-instrumentations-node": "^0.56.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "@sentry/nextjs": "^9.0.0",
    "ioredis": "^5.6.1",
    "next": "^15.5.16",
    "next-intl": "^4.9.2",
    "next-themes": "^0.4.6",
    "react": "19.2.6",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.4",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "typescript": "^5.7.0",
    "vitest": "^3.1.2"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.2",
      "postcss": ">=8.5.14"
    }
  }
}