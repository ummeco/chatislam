    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-astro": "^1.3.0",
    "lighthouse": "^12.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
