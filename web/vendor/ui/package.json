{
  "name": "@ummat/ui",
  "version": "0.1.0",
  "description": "Shared UI components for all Ummeco web apps (canonical packages/ location). Renamed from @ummat/ui-pkg — P9 UI-PKG-RENAME.",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles": "./src/components.css",
    "./a11y": "./src/a11y.css",
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "import": "./src/tokens/index.ts"
    },
    "./tailwind-preset": {
      "types": "./tailwind-preset.ts",
      "import": "./tailwind-preset.ts"
    },
    "./button": "./src/components/Button.tsx",
    "./input": "./src/components/Input.tsx",
    "./badge": "./src/components/Badge.tsx",
    "./card": "./src/components/Card.tsx",
    "./modal": "./src/components/Modal.tsx",
    "./toast": "./src/components/Toast.tsx",
    "./avatar": "./src/components/Avatar.tsx",
    "./skeleton": "./src/components/Skeleton.tsx",
    "./banner": "./src/components/Banner.tsx",
    "./data-state": "./src/components/DataState.tsx",
    "./focus-ring": "./src/components/FocusRing.tsx",
    "./async-screen": "./src/components/AsyncScreen.tsx",
    "./async-screen-native": "./src/components/AsyncScreen.native.tsx",
    "./error-boundary": "./src/components/ErrorBoundary.tsx"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "test-storybook": "test-storybook --url http://127.0.0.1:6006"
  },
  "peerDependencies": {
    "@ummat/brand": "file:../brand",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": ">=3.4.0 <4"
  },
  "peerDependenciesMeta": {
    "@ummat/brand": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8",
    "@storybook/addon-docs": "^8",
    "@storybook/addon-essentials": "^8",
    "@storybook/addon-viewport": "^8",
    "@storybook/react-vite": "^8",
    "@storybook/test-runner": "^0.24.4",
    "@testing-library/react": "^16",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@ummat/brand": "workspace:*",
    "@vitest/coverage-v8": "^3.2.6",
    "axe-core": "catalog:",
    "axe-playwright": "^2",
    "jsdom": "^26",
    "storybook": "^8",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.3.5",
    "typescript": "^5.0.0",
    "vite": ">=7.0.0 <9.0.0",
    "vitest": "^3.2.6"
  },
  "sideEffects": false
}
