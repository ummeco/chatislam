---
/**
 * cookie-policy/index.astro — Cookie policy (static)
 * REF: P2-E3-W02-S02-T02
 */

import BaseLayout from '../../layouts/BaseLayout.astro'
import SiteNav from '../../components/SiteNav.astro'

const title       = 'Cookie Policy — ChatIslam'
const description = 'ChatIslam cookie policy.'
---

<BaseLayout title={title} description={description}>
  <SiteNav currentPath="/cookie-policy" />
  <main id="main-content" style="max-width: 800px; margin: 0 auto; padding: 3rem 1.5rem;">
    <h1 style="font-size: 2rem; font-weight: 700; color: var(--brand-green-light); margin-bottom: 1.5rem;">Cookie Policy</h1>
    <p style="font-size: 0.875rem; color: var(--brand-green-mid); margin-bottom: 1rem;">Last updated: June 2026</p>
    <section style="line-height: 1.7; color: var(--brand-green-light); font-size: 0.9rem;">
      <p>ChatIslam uses minimal cookies. Umami analytics (cookieless) is our only analytics tool.
         Cloudflare Turnstile uses a challenge cookie for bot protection only.</p>
      <p style="margin-top: 1rem;">Chat sessions are not tracked cookies. No advertising cookies are used.</p>
    </section>
  </main>
</BaseLayout>
