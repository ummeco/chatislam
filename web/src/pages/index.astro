---
/**
 * index.astro — ChatIslam landing page (static)
 *
 * PURPOSE: SEO-optimised static homepage. AI fatwa disclaimer (SCI-11).
 *          CTA to /chat.
 * CONSTRAINTS: No Next.js. Astro static page. No hCaptcha.
 * REF: P2-E3-W02-S02-T02
 */

import BaseLayout from '../layouts/BaseLayout.astro'
import SiteNav from '../components/SiteNav.astro'
import DisclaimerBanner from '../components/DisclaimerBanner.astro'

const title       = 'ChatIslam — Ask Anything About Islam'
const description = 'AI-powered Islamic guidance — accurate, sourced, always available. Ask questions about Islam, get answers grounded in authentic scholarship.'
---

<BaseLayout title={title} description={description}>
  <SiteNav currentPath="/" />

  <main id="main-content" style="max-width: 800px; margin: 0 auto; padding: 3rem 1.5rem; text-align: center;">
    <!-- Hero -->
    <h1 style="font-size: 3rem; font-weight: 700; color: var(--brand-green-light); margin-bottom: 1rem; line-height: 1.15;">
      ChatIslam
    </h1>
    <p style="font-size: 1.25rem; color: var(--brand-green-mid); margin-bottom: 0.5rem; max-width: 560px; margin-inline: auto;">
      AI-assisted Islamic Q&amp;A — grounded in the Quran and authentic Sunnah.
    </p>

    <!-- Legal disclaimer (SCI-11) -->
    <DisclaimerBanner />

    <!-- Features summary -->
    <ul
      aria-label="Features"
      style="
        list-style: none;
        padding: 0;
        margin: 2rem auto;
        max-width: 480px;
        display: grid;
        gap: 0.75rem;
        text-align: start;
      "
    >
      <li style="display: flex; gap: 0.5rem; align-items: flex-start; font-size: 0.9rem; color: var(--brand-green-light);">
        <span aria-hidden="true" style="color: var(--brand-green-mid); flex-shrink: 0;">✓</span>
        Audience modes: General Q&amp;A, Dawah (outreach), Learning (tutoring)
      </li>
      <li style="display: flex; gap: 0.5rem; align-items: flex-start; font-size: 0.9rem; color: var(--brand-green-light);">
        <span aria-hidden="true" style="color: var(--brand-green-mid); flex-shrink: 0;">✓</span>
        Ahl us-Sunnah wal-Jamaa&apos;ah theology guidelines — authentic scholarship only
      </li>
      <li style="display: flex; gap: 0.5rem; align-items: flex-start; font-size: 0.9rem; color: var(--brand-green-light);">
        <span aria-hidden="true" style="color: var(--brand-green-mid); flex-shrink: 0;">✓</span>
        Multi-language support including Arabic (RTL), Urdu, Farsi, French
      </li>
      <li style="display: flex; gap: 0.5rem; align-items: flex-start; font-size: 0.9rem; color: var(--brand-green-light);">
        <span aria-hidden="true" style="color: var(--brand-green-mid); flex-shrink: 0;">✓</span>
        Free to use — no account required
      </li>
    </ul>

    <!-- CTA -->
    <a
      href="/chat"
      style="
        display: inline-block;
        background-color: var(--brand-green-mid);
        color: var(--brand-green-deep);
        padding: 0.875rem 2rem;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 700;
        text-decoration: none;
        transition: background-color 150ms ease;
      "
      onmouseover="this.style.backgroundColor='var(--brand-green-light)'"
      onmouseout="this.style.backgroundColor='var(--brand-green-mid)'"
    >
      Start Asking
    </a>
  </main>

  <!-- Footer -->
  <footer style="text-align: center; padding: 2rem 1.5rem; border-top: 1px solid var(--brand-green-dark); font-size: 0.75rem; color: rgba(201,242,122,0.4);">
    <nav aria-label="Footer links" style="display: flex; gap: 1.5rem; justify-content: center; margin-bottom: 0.75rem; flex-wrap: wrap;">
      <a href="/legal/sharia-disclaimer">Sharia Disclaimer</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="/cookie-policy">Cookie Policy</a>
      <a href="/donate">Donate</a>
    </nav>
    <p style="margin: 0;">
      © {new Date().getFullYear()} ChatIslam · Powered by Anthropic
    </p>
  </footer>
</BaseLayout>
